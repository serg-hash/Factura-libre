---
import Header from "@/app/Header";
import { withAsset } from "@/lib/paths";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Factura Libre",
  description = "Generador de facturas gratis y offline para autónomos y pymes en España. IVA, IRPF y PDF en el navegador.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://serg-hash.github.io");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#9c3b1e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={withAsset("og.svg")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={withAsset("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("factura-libre-theme") || "system";
          var dark =
            theme === "dark" ||
            (theme !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          var locale = localStorage.getItem("factura-libre-locale") || "es";
          document.documentElement.lang = locale === "en" ? "en" : "es";
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-full focus:bg-elev focus:px-3 focus:py-2" href="#contenido">
      Saltar al contenido
    </a>
    <Header client:only="react" current={Astro.url.pathname} />
    <main id="contenido" class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-4 pb-10 text-xs text-mute">
      <p>
        Factura Libre · MIT ·
        <a class="underline" href="https://github.com/serg-hash/Factura-libre">GitHub</a>
        · Los datos no salen de este navegador.
      </p>
    </footer>
  </body>
</html>
